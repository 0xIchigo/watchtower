# Copy to .env (git-ignored) and fill in. Watchtower reads it from the folder you run it in.

# Required. Get a key at https://dashboard.helius.dev
HELIUS_API_KEY=

# Dashboard (`watchtower serve`). Needed only when hosting it beyond localhost:
# set a password for a private dashboard, or READONLY=true for a public status page.
# WATCHTOWER_PASSWORD=
# WATCHTOWER_READONLY=true
# PORT=4545

# Optional endpoint overrides (the Helius SDK's defaults otherwise)
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com
# HELIUS_PARSED_STREAMS_URL=wss://beta.helius-rpc.com

# Alert channel secrets are added below automatically when you save channels in
# the dashboard or `watchtower init`; watchtower.yaml refers to them as ${NAME}.
